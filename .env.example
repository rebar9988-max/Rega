# Copy to .env.local and fill in. Never commit real values.
DATABASE_URL=postgresql://user:password@localhost:5432/rega
DIRECT_DATABASE_URL=postgresql://user:password@localhost:5432/rega
AUTH_SECRET=            # openssl rand -base64 32
AUTH_URL=http://localhost:3000
CANONICAL_HOST=www.regaplatform.com

# --- REGA AI Gateway (optional) -------------------------------------------------
# AI_PROVIDER: auto (default: all providers with a key, with fallback) | disabled | gemini | grok | openai | groq | deepseek | openrouter | anthropic (only that one)
AI_PROVIDER=disabled
# Secrets: set them ONLY in your host's secret/environment settings, never in git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
XAI_API_KEY=
GROK_MODEL=grok-4.7
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
OPENROUTER_API_KEY=
# OpenRouter model ids are "vendor/model".
OPENROUTER_MODEL=google/gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# GROK_BASE_URL=https://api.x.ai/v1
# Routing: same order for every task, or per-task JSON. Defaults live in src/lib/ai/routing.ts.
# AI_PROVIDER_ORDER=gemini,openai,grok,groq,deepseek,openrouter,anthropic
# AI_ROUTING={"chat":["gemini","openai","grok","groq","deepseek","openrouter","anthropic"],"summarize":["groq","deepseek","gemini"]}
AI_TIMEOUT_MS=20000
AI_DAILY_LIMIT=5000

# Optional internal Python AI engine (advanced reranking/embeddings only).
# Keep the token server-side. Leave URL/token empty to use REGA's existing retrieval path unchanged.
AI_SERVICE_URL=
AI_SERVICE_TOKEN=
AI_SERVICE_TIMEOUT_MS=1500

# Media storage (optional, any S3-compatible bucket)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_URL=
MEDIA_PUBLIC_HOST=

# Address -> coordinates in the admin business form (no key needed with the default public Nominatim).
# GEOCODING_PROVIDER=nominatim   # nominatim | none (admins then place the marker on the map)
# GEOCODING_URL=https://nominatim.openstreetmap.org
# Basemap style (public URL, not a secret): NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# First admin + demo data (used by `npm run db:seed`)
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=     # min. 12 characters
# SEED_DEMO=1              # development only

# --- Official social profiles (optional, PUBLIC URLs, not secrets). Only https URLs on the platform's own domain are accepted.
# The official display name on every platform is "REGA Platform" (SOCIAL_DISPLAY_NAME in src/lib/seo.ts).
# They feed the footer links and Organization `sameAs` structured data. Leave unset until the real profile exists.
SOCIAL_FACEBOOK_URL=
SOCIAL_INSTAGRAM_URL=
SOCIAL_TIKTOK_URL=
SOCIAL_YOUTUBE_URL=
SOCIAL_LINKEDIN_URL=
SOCIAL_X_URL=
SOCIAL_TELEGRAM_URL=
SOCIAL_WHATSAPP_CHANNEL_URL=

# --- E-mail (verification, password reset, contact + report notifications) ----------------------------------
# EMAIL_PROVIDER: none (default, nothing is sent; public submissions stay locked because addresses cannot be verified) | resend
EMAIL_PROVIDER=none
RESEND_API_KEY=
EMAIL_FROM="REGA Platform <noreply@regaplatform.com>"
# Where contact messages and content reports are announced.
CONTACT_INBOX=info@regaplatform.com

# --- Sections (config/sections.ts): switch sections on/off without code changes (comma-separated keys) -----
# SECTIONS_ENABLED=jobs,events
# SECTIONS_DISABLED=nearby

# --- Operations ---------------------------------------------------------------------------------------------
# Sign-in attempts per account per 15 minutes (default 10); only raise it for automated tests.
# AUTH_LOGIN_ATTEMPTS=10
# When set, every logged error is also POSTed there as JSON (off when unset).
# ERROR_WEBHOOK_URL=
# Optional OAuth sign-in: not enabled in this build (docs/adr/0006-oauth-deferred.md).
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# --- Operator details for Impressum / Privacy / Contact (PUBLIC, not secrets; src/config/owner.ts) ----------
# Empty fields render as visible [[PLACEHOLDERS]] on the legal pages. Fill in before go-live.
LEGAL_OPERATOR_TYPE=
LEGAL_NAME=
LEGAL_RESPONSIBLE_PERSON=
LEGAL_STREET_ADDRESS=
LEGAL_POSTAL_CODE_CITY=
LEGAL_COUNTRY=Germany
LEGAL_PUBLIC_EMAIL=info@regaplatform.com
LEGAL_PHONE=+49 178 4228269
LEGAL_VAT_ID=
LEGAL_TRADE_REGISTER=
# Which provider serves REGA Assistant answers (named in the privacy policy).
LEGAL_AI_PROVIDER=
LEGAL_HOSTING_PROVIDER=Cloudflare, Inc. (Cloudflare Workers, R2)
LEGAL_ANALYTICS_TOOL=none
# Named in the privacy policy when e-mails are sent (defaults to Resend when EMAIL_PROVIDER=resend).
LEGAL_EMAIL_PROVIDER=
