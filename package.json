{
  "name": "rega-platform",
  "version": "0.1.0",
  "private": true,
  "description": "REGA Platform - production web application (www.rega24.com)",
  "scripts": {
    "dev": "node scripts/vendor-maplibre.mjs && next dev",
    "build": "node scripts/vendor-maplibre.mjs && npm run db:generate && REGA_TARGET=workers opennextjs-cloudflare build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate && node scripts/generate-d1-models.mjs && prisma generate --schema prisma/d1/schema.prisma",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "backup": "bash scripts/backup.sh",
    "test": "tsx --test tests/*.test.ts",
    "e2e": "playwright test",
    "build:node": "node scripts/vendor-maplibre.mjs && npm run db:generate && next build --webpack",
    "cf:preview": "npm run build && opennextjs-cloudflare preview",
    "cf:dry-run": "opennextjs-cloudflare deploy --dry-run --tag dry-run-verification --message Verified-GitHub-CI-release",
    "guard:identity": "node scripts/project-identity-guard.mjs --project REGA",
    "test:d1": "node scripts/generate-d1-models.mjs --check && NODE_OPTIONS=--conditions=react-server tsx --test tests/d1/*.test.ts && python3 scripts/test-d1-batches.py",
    "db:d1:local": "node scripts/init-local-d1.mjs",
    "db:d1:migrate": "node scripts/project-identity-guard.mjs --project REGA && wrangler d1 migrations apply rega24-migration --remote"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.800.0",
    "@aws-sdk/s3-request-presigner": "^3.800.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@opennextjs/cloudflare": "1.20.12",
    "@prisma/adapter-d1": "6.19.3",
    "@prisma/adapter-pg": "~6.19.3",
    "@prisma/client": "~6.19.3",
    "bcryptjs": "^3.0.2",
    "fast-png": "^8.0.0",
    "jpeg-js": "^0.4.4",
    "maplibre-gl": "^6.11.2",
    "next": "16.4.2",
    "next-auth": "^5.0.0-beta.28",
    "next-intl": "^4.1.0",
    "pg": "^8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "simple-icons": "^16.33.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.3.0",
    "prisma": "~6.19.3",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.144.0"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "deepmerge-ts": "^8.0.2",
    "glob@10.3.3": "^10.5.0",
    "undici@7.29.1": "^7.30.1"
  }
}
