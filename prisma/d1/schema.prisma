// STAGED D1 candidate; see docs/D1-MIGRATION.md. Not the active application schema.
generator client {
  provider   = "prisma-client-js"
  output     = "../../node_modules/@rega/d1-client"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./rehearsal.db"
}

// ----------------------------------------------------------------- Auth / RBAC

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EMPLOYEE
  /// Self-registered owner of listings: manages only the businesses they are a member of, never enters /dr as staff.
  BUSINESS_OWNER
  USER
}

model User {
  foldedName      String?
  foldedEmail     String    @default("")
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerified   DateTime?
  passwordHash    String?
  name            String?
  phone           String?
  avatarUrl       String?
  locale          String    @default("ckb")
  role            Role      @default(USER)
  status          String    @default("active") // active | suspended | invited
  lastLoginAt     DateTime?
  /// When the account holder accepted the Terms and the Privacy policy at registration (GDPR evidence).
  termsAcceptedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  accounts    Account[]
  sessions    Session[]
  memberships BusinessMember[]
  auditLogs   AuditLog[]
  reviews     Review[]

  @@index([role, status])
  @@index([deletedAt])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Administrative sign-in codes for /dr. Separate from VerificationToken so dashboard access
/// never shares a row, a cooldown or a guess budget with e-mail verification or password reset.
/// Only an HMAC of the six digits is stored (see features/auth/admin-code-core.ts).
model AdminSignInCode {
  email     String   @id
  codeHash  String
  state     String   @default("pending") // pending | active
  expiresAt DateTime
  attempts  Int      @default(0)
  sentAt    DateTime @default(now())
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

// ----------------------------------------------------------------- Geography

model Country {
  id        String   @id @default(cuid())
  code      String   @unique // ISO-3166-1 alpha-2
  nameEn    String
  nameCkb   String?
  nameKmr   String?
  nameDe    String?
  nameFa    String?
  nameAr    String?
  nameTr    String?
  latitude  Float?
  longitude Float?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  cities       City[]
  regions      Region[]
  translations CountryTranslation[]
}

/// Federal state / region between a country and its cities (Country -> Region -> City).
model Region {
  id        String   @id @default(cuid())
  countryId String
  slug      String
  nameEn    String
  latitude  Float?
  longitude Float?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country      Country             @relation(fields: [countryId], references: [id], onDelete: Restrict)
  cities       City[]
  translations RegionTranslation[]

  @@unique([countryId, slug])
  @@index([countryId, sortOrder])
}

/// Translations live in rows keyed by locale: a new language needs no schema change. The legacy name<Locale> columns
/// stay authoritative for the seven launch locales; rows here win, then the columns (see src/lib/content.ts).
model CountryTranslation {
  id        String  @id @default(cuid())
  countryId String
  locale    String
  name      String
  country   Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([countryId, locale])
}

model RegionTranslation {
  id       String @id @default(cuid())
  regionId String
  locale   String
  name     String
  region   Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([regionId, locale])
}

model CityTranslation {
  foldedName String @default("")
  id         String @id @default(cuid())
  cityId     String
  locale     String
  name       String
  city       City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([cityId, locale])
}

model City {
  foldedSlug    String?
  foldedNameTr  String?
  foldedNameAr  String?
  foldedNameFa  String?
  foldedNameDe  String?
  foldedNameKmr String?
  foldedNameCkb String?
  foldedNameEn  String   @default("")
  id            String   @id @default(cuid())
  countryId     String
  regionId      String?
  /// URL slug (/city/<slug>); seeded and generated for new cities, unique across all countries.
  slug          String?  @unique
  nameEn        String
  nameCkb       String?
  nameKmr       String?
  nameDe        String?
  nameFa        String?
  nameAr        String?
  nameTr        String?
  sortOrder     Int      @default(0)
  latitude      Float?
  longitude     Float?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  country      Country           @relation(fields: [countryId], references: [id], onDelete: Restrict)
  region       Region?           @relation(fields: [regionId], references: [id], onDelete: SetNull)
  locations    Location[]
  translations CityTranslation[]
  listings     Listing[]

  @@unique([countryId, nameEn])
  @@index([nameEn])
  @@index([regionId])
  @@index([isActive, sortOrder])
}

// ----------------------------------------------------------------- Taxonomy

model Category {
  id             String    @id @default(cuid())
  // Seeded stable key (slug) enabling translations to be edited without breaking links
  key            String    @unique
  slug           String    @unique
  parentId       String?
  nameCkb        String
  nameKmr        String?
  nameDe         String
  nameEn         String?
  nameAr         String?
  nameFa         String?
  nameTr         String?
  descriptionCkb String?
  descriptionDe  String?
  descriptionAr  String?
  iconUrl        String?
  /// Icon name from the shared icon set (see src/components/home/icons.tsx); iconUrl is the legacy image URL.
  icon           String?
  /// Which section the category belongs to (config/sections.ts key): jobs, events, ... get their own trees.
  sectionKey     String    @default("businesses")
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]            @relation("CategoryTree")
  services     Service[]
  businesses   Business[]
  translations CategoryTranslation[]
  listings     Listing[]

  @@index([parentId, sortOrder])
  @@index([sectionKey, isActive])
  @@index([isActive, sortOrder])
}

model CategoryTranslation {
  id          String   @id @default(cuid())
  categoryId  String
  locale      String
  name        String
  description String?
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([locale])
}

// ----------------------------------------------------------------- Core entities

model Business {
  foldedName     String    @default("")
  id             String    @id @default(cuid())
  slug           String    @unique
  name           String
  nameCkb        String?
  nameKmr        String?
  nameAr         String?
  nameTr         String?
  description    String?
  descriptionCkb String?
  descriptionKmr String?
  descriptionDe  String?
  descriptionAr  String?
  descriptionTr  String?
  email          String?
  phone          String?
  /// Public business WhatsApp number in international format ("+491784228269"). Never the owner's account phone.
  whatsapp       String?
  website        String?
  /// Optional official social profiles: https URLs on each platform's own domain (src/lib/social-links.ts). Empty = no button.
  /// Production D1 migration 0004_business_social_links (applied 2026-10-29); PostgreSQL 20261024220000.
  instagramUrl   String?
  facebookUrl    String?
  tiktokUrl      String?
  snapchatUrl    String?
  logoUrl        String?
  coverUrl       String?
  status         String    @default("draft") // draft | pending (submitted for review) | published | archived
  verified       Boolean   @default(false)
  featured       Boolean   @default(false)
  ratingAvg      Float     @default(0)
  ratingCount    Int       @default(0)
  viewCount      Int       @default(0)
  tags           Json      @default("[]")
  /// Languages spoken at the business (locale codes from config/locales.ts).
  languages      Json      @default("[]")
  /// Public photos of the business (REGA media URLs, in display order). Logo and cover have their own columns.
  photos         Json      @default("[]")
  searchText     String    @default("")
  publishedAt    DateTime?
  archivedAt     DateTime?
  deletedAt      DateTime?
  createdById    String?
  /// Primary category chosen by the admin (services may add more). Nullable: older businesses keep working.
  categoryId     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  category     Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  locations    Location[]
  services     Service[]
  members      BusinessMember[]
  media        Media[]
  reviews      Review[]
  translations BusinessTranslation[]
  listings     Listing[]
  offers       Offer[]

  @@index([status, deletedAt, createdAt])
  @@index([status, featured])
  @@index([status, ratingAvg])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([categoryId])
}

/// Per-locale text of a listing for languages without a legacy column (en, fa, and any language added later).
model BusinessTranslation {
  id          String   @id @default(cuid())
  businessId  String
  locale      String
  name        String?
  description String?
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, locale])
}

model Location {
  id               String    @id @default(cuid())
  businessId       String
  label            String?
  addressLine1     String
  addressLine2     String?
  cityId           String?
  postalCode       String?
  countryCode      String
  latitude         Float?
  longitude        Float?
  /// How the coordinates were set: "geocoded" (address lookup confirmed by an admin) or "manual" (placed on the map).
  coordsSource     String?
  /// When an admin confirmed that the marker is at the business. Required to publish.
  coordsVerifiedAt DateTime?
  phone            String?
  email            String?
  openingHours     Json?
  isPrimary        Boolean   @default(false)
  status           String    @default("active") // active | archived
  searchText       String    @default("")
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  city     City?    @relation(fields: [cityId], references: [id], onDelete: SetNull)

  @@index([businessId, isPrimary])
  @@index([latitude, longitude])
  @@index([cityId])
  @@index([status])
}

model Service {
  id             String    @id @default(cuid())
  businessId     String
  categoryId     String?
  slug           String
  name           String
  nameCkb        String?
  nameKmr        String?
  nameAr         String?
  nameTr         String?
  description    String?
  descriptionCkb String?
  descriptionDe  String?
  descriptionAr  String?
  priceFrom      Decimal?
  priceTo        Decimal?
  currency       String    @default("EUR")
  durationMin    Int?
  coverUrl       String?
  status         String    @default("draft") // draft | published | archived
  featured       Boolean   @default(false)
  sortOrder      Int       @default(0)
  searchText     String    @default("")
  archivedAt     DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  media    Media[]

  @@unique([businessId, slug])
  @@index([categoryId, status])
  @@index([status, featured])
}

/// A genuine, time-limited offer of one business. There is deliberately no "original price" column: REGA never stores
/// or shows a computed "was/now" price, only the discount the owner really gives (none | percent | amount).
/// Whether an offer is running is never stored: it is computed from `isActive`, `startsAt` and `endsAt` on every read
/// (src/lib/offers.ts), so an expired or not-yet-started offer can never look active. Money/percent rules are also
/// enforced by CHECK constraints in the migration.
model Offer {
  id            String   @id @default(cuid())
  businessId    String
  title         String
  description   String?
  imageUrl      String?
  /// none = no numeric discount | percent = 1-90 % off | amount = a fixed amount off, in `currency`.
  discountType  String   @default("none")
  discountValue Decimal?
  currency      String?
  startsAt      DateTime
  endsAt        DateTime
  /// Owner switch: false = deactivated.
  isActive      Boolean  @default(true)
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, isActive, startsAt, endsAt])
}

model BusinessMember {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  role       Role     @default(EMPLOYEE)
  title      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
}

model Media {
  id           String    @id @default(cuid())
  businessId   String?
  serviceId    String?
  uploadedById String?
  kind         String    @default("image") // image | document | video
  storageKey   String    @unique
  url          String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  altCkb       String?
  altDe        String?
  altAr        String?
  altTr        String?
  checksum     String?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service?  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([serviceId])
}

model Review {
  id            String    @id @default(cuid())
  businessId    String
  userId        String?
  rating        Int
  comment       String?
  /// Language of the page the review was written on (shown with the text so it is displayed with the right lang/dir).
  locale        String    @default("de")
  status        String    @default("pending") // pending | approved | rejected
  moderatedById String?
  moderatedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// One review per user per business (a new submission replaces the old one). NULL user ids never collide.
  @@unique([businessId, userId])
  @@index([businessId, status])
  @@index([status, createdAt])
}

// ----------------------------------------------------------------- Platform ops

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String // business.create, user.role.update, ...
  entity     String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique // public.aiSearch, public.reviews, ...
  description String?
  enabled     Boolean  @default(false)
  rollout     Int      @default(0) // 0-100 percentage rollout
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Setting {
  key       String   @id // ai.provider, site.defaultLocale, ...
  value     Json
  isSecret  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model AiConversation {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String
  locale    String
  createdAt DateTime @default(now())

  messages AiMessage[]

  @@index([sessionId, createdAt])
}

model AiMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // user | assistant | system
  content        String
  provider       String?
  model          String?
  tokensIn       Int?
  tokensOut      Int?
  latencyMs      Int?
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AiUsageDaily {
  id        String   @id @default(cuid())
  day       DateTime
  provider  String
  model     String
  requests  Int      @default(0)
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)

  @@unique([day, provider, model])
}

/// Search analytics: how often a normalized search text was searched per day and language, and how often it found
/// nothing. No user, session, IP or device data; texts that look personal are never stored (lib/search-analytics.ts).
/// Written by one atomic UPSERT per search, never through a read-modify-write transaction.
model SearchQueryDaily {
  id          String @id
  /// UTC day, YYYY-MM-DD.
  day         String
  locale      String
  query       String
  searches    Int    @default(0)
  zeroResults Int    @default(0)

  @@unique([day, locale, query])
  @@index([day])
}

// ----------------------------------------------------------------- Legal, trust & communication

/// Notice-and-action reports (Digital Services Act): anyone can report a page or listing.
model Report {
  id            String    @id @default(cuid())
  /// business | service | page | other
  kind          String    @default("other")
  targetUrl     String
  targetId      String?
  reason        String // illegal | misleading | spam | copyright | privacy | other
  details       String
  reporterName  String?
  reporterEmail String?
  locale        String
  status        String    @default("open") // open | reviewing | actioned | dismissed
  handledById   String?
  handledAt     DateTime?
  note          String?
  createdAt     DateTime  @default(now())

  @@index([status, createdAt])
  @@index([createdAt])
}

/// Messages from the contact form (stored, then e-mailed to the team).
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String?
  subject   String
  message   String
  locale    String
  status    String   @default("new") // new | read | replied | spam
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

/// CMS-style static pages (about text, guides templates, extra legal notes), translated per locale.
model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  status    String   @default("draft") // draft | published | archived
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations PageTranslation[]

  @@index([status, sortOrder])
}

model PageTranslation {
  id              String  @id @default(cuid())
  pageId          String
  locale          String
  title           String
  body            String
  metaDescription String?
  page            Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, locale])
}

// ----------------------------------------------------------------- Shared core of the content sections (jobs, events, guides, ...)

/// Core entity of every content section (config/sections.ts key in `sectionKey`). Section-specific fields live in a
/// typed extension table linked 1:1 (JobDetails, EventDetails, GuideDetails); texts live in ListingTranslation rows
/// (one per locale, so a new language needs no schema change). A new section adds its own details table, not a new core.
model Listing {
  id          String    @id @default(cuid())
  sectionKey  String
  slug        String
  status      String    @default("draft") // draft | pending | published | archived
  verified    Boolean   @default(false)
  /// Employer / organizer: a Business.
  businessId  String?
  createdById String?
  cityId      String?
  categoryId  String?
  publishedAt DateTime?
  /// Jobs: last day the posting is shown. Events use EventDetails.endsAt/startsAt instead.
  expiresAt   DateTime?
  searchText  String    @default("")
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business     Business?            @relation(fields: [businessId], references: [id], onDelete: SetNull)
  city         City?                @relation(fields: [cityId], references: [id], onDelete: SetNull)
  category     Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  translations ListingTranslation[]
  job          JobDetails?
  event        EventDetails?
  guide        GuideDetails?

  @@unique([sectionKey, slug])
  @@index([sectionKey, status, publishedAt])
  @@index([cityId])
  @@index([categoryId])
  @@index([businessId])
  @@index([createdAt])
}

model ListingTranslation {
  id        String  @id @default(cuid())
  listingId String
  locale    String
  title     String
  summary   String?
  body      String?
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, locale])
}

model JobDetails {
  listingId      String  @id
  /// full_time | part_time | mini_job | apprenticeship | internship | freelance
  employmentType String  @default("full_time")
  applyUrl       String?
  applyEmail     String?
  /// Languages required / used at work (locale codes).
  languages      Json    @default("[]")
  listing        Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model EventDetails {
  listingId String    @id
  startsAt  DateTime
  endsAt    DateTime?
  venue     String?
  infoUrl   String?
  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([startsAt])
}

model GuideDetails {
  listingId   String  @id
  readMinutes Int?
  listing     Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}
