// Prisma schema — REGA Platform
// PostgreSQL. Portable: any managed Postgres (Neon, Supabase, Cloud SQL, RDS).
// Migrations live in prisma/migrations — data never depends on the provider.

generator client {
  provider   = "prisma-client-js"
  // Rust-free query compiler + driver adapter (pg): one client for Node and Cloudflare Workers.
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ----------------------------------------------------------------- Auth / RBAC

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EMPLOYEE
  USER
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String?
  phone         String?
  avatarUrl     String?
  locale        String    @default("ckb")
  role          Role      @default(USER)
  status        String    @default("active") // active | suspended | invited
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  accounts  Account[]
  sessions  Session[]
  memberships BusinessMember[]
  auditLogs AuditLog[]

  @@index([role, status])
  @@index([deletedAt])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

// ----------------------------------------------------------------- Geography

model Country {
  id        String   @id @default(cuid())
  code      String   @unique // ISO-3166-1 alpha-2
  nameEn    String
  nameCkb   String?
  nameKmr   String?
  nameDe    String?
  nameAr    String?
  nameTr    String?
  createdAt DateTime @default(now())

  cities City[]
}

model City {
  id         String   @id @default(cuid())
  countryId  String
  nameEn     String
  nameCkb    String?
  nameKmr    String?
  nameDe     String?
  nameAr    String?
  nameTr    String?
  latitude   Float?
  longitude  Float?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  country   Country    @relation(fields: [countryId], references: [id], onDelete: Restrict)
  locations Location[]

  @@unique([countryId, nameEn])
  @@index([nameEn])
}

// ----------------------------------------------------------------- Taxonomy

model Category {
  id          String    @id @default(cuid())
  // Seeded stable key (slug) enabling translations to be edited without breaking links
  key         String    @unique
  slug        String    @unique
  parentId    String?
  nameCkb     String
  nameKmr     String?
  nameDe      String
  nameAr      String?
  nameTr      String?
  descriptionCkb String?
  descriptionDe  String?
  descriptionAr  String?
  iconUrl     String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  services Service[]
  businesses Business[]

  @@index([parentId, sortOrder])
  @@index([isActive, sortOrder])
}

// ----------------------------------------------------------------- Core entities

model Business {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  nameCkb       String?
  nameKmr       String?
  nameAr        String?
  nameTr        String?
  description   String?
  descriptionCkb String?
  descriptionKmr String?
  descriptionDe  String?
  descriptionAr  String?
  descriptionTr  String?
  email         String?
  phone         String?
  website       String?
  logoUrl       String?
  coverUrl      String?
  status        String    @default("draft") // draft | published | archived
  verified      Boolean   @default(false)
  featured      Boolean   @default(false)
  ratingAvg     Float     @default(0)
  ratingCount   Int       @default(0)
  viewCount     Int       @default(0)
  tags          String[]  @default([])
  searchText    String    @default("")
  publishedAt   DateTime?
  archivedAt    DateTime?
  deletedAt     DateTime?
  createdById   String?
  /// Primary category chosen by the admin (services may add more). Nullable: older businesses keep working.
  categoryId    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  locations     Location[]
  services      Service[]
  members       BusinessMember[]
  media         Media[]
  reviews       Review[]

  @@index([status, featured])
  @@index([status, ratingAvg])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "Business_searchText_trgm_idx")
  @@index([deletedAt])
  @@index([createdAt])
  @@index([categoryId])
}

model Location {
  id           String    @id @default(cuid())
  businessId   String
  label        String?
  addressLine1 String
  addressLine2 String?
  cityId       String?
  postalCode   String?
  countryCode  String
  latitude     Float?
  longitude    Float?
  /// How the coordinates were set: "geocoded" (address lookup confirmed by an admin) or "manual" (placed on the map).
  coordsSource     String?
  /// When an admin confirmed that the marker is at the business. Required to publish.
  coordsVerifiedAt DateTime?
  phone        String?
  email        String?
  openingHours Json?
  isPrimary    Boolean   @default(false)
  status       String    @default("active") // active | archived
  searchText   String    @default("")
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  city     City?    @relation(fields: [cityId], references: [id], onDelete: SetNull)

  @@index([businessId, isPrimary])
  @@index([latitude, longitude])
  @@index([cityId])
  @@index([status])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "Location_searchText_trgm_idx")
}

model Service {
  id            String    @id @default(cuid())
  businessId    String
  categoryId    String?
  slug          String
  name          String
  nameCkb       String?
  nameKmr       String?
  nameAr        String?
  nameTr        String?
  description   String?
  descriptionCkb String?
  descriptionDe  String?
  descriptionAr  String?
  priceFrom     Decimal?  @db.Decimal(12, 2)
  priceTo       Decimal?  @db.Decimal(12, 2)
  currency      String    @default("EUR")
  durationMin   Int?
  coverUrl      String?
  status        String    @default("draft") // draft | published | archived
  featured      Boolean   @default(false)
  sortOrder     Int       @default(0)
  searchText    String    @default("")
  archivedAt    DateTime?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  media    Media[]

  @@unique([businessId, slug])
  @@index([categoryId, status])
  @@index([status, featured])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "Service_searchText_trgm_idx")
}

model BusinessMember {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  role       Role     @default(EMPLOYEE)
  title      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
}

model Media {
  id           String   @id @default(cuid())
  businessId   String?
  serviceId    String?
  uploadedById String?
  kind         String   @default("image") // image | document | video
  storageKey   String   @unique
  url          String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  altCkb       String?
  altDe        String?
  altAr        String?
  altTr        String?
  checksum     String?
  createdAt    DateTime @default(now())
  deletedAt    DateTime?

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service?  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([serviceId])
}

model Review {
  id         String   @id @default(cuid())
  businessId String
  userId     String?
  rating     Int
  comment    String?
  status     String   @default("pending") // pending | approved | rejected
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
}

// ----------------------------------------------------------------- Platform ops

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String   // business.create, user.role.update, ...
  entity     String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique // public.aiSearch, public.reviews, ...
  description String?
  enabled     Boolean  @default(false)
  rollout     Int      @default(0) // 0-100 percentage rollout
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Setting {
  key       String   @id // ai.provider, site.defaultLocale, ...
  value     Json
  isSecret  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model AiConversation {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String
  locale    String
  createdAt DateTime @default(now())

  messages AiMessage[]

  @@index([sessionId, createdAt])
}

model AiMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // user | assistant | system
  content        String
  provider       String?
  model          String?
  tokensIn       Int?
  tokensOut      Int?
  latencyMs      Int?
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AiUsageDaily {
  id        String   @id @default(cuid())
  day       DateTime @db.Date
  provider  String
  model     String
  requests  Int      @default(0)
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)

  @@unique([day, provider, model])
}
