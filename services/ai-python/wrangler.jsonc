{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rega-ai-python",
  "main": "src/main.py",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  // No production AI binding or provider credentials in branch previews.
  "previews": { "vars": { "REGA_ISOLATED_PREVIEW": "1" } },
  "observability": { "enabled": true, "redact_query_string": true },
  "ai": { "binding": "AI", "remote": true },
  "vars": {
    "AI_EMBEDDING_MODEL": "@cf/baai/bge-m3",
    "AI_RERANK_MODEL": "@cf/baai/bge-reranker-base"
  }
}
